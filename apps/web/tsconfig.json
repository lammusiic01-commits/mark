{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@mark/shared": ["../../packages/shared/src/index.ts"],
      "@mark/shared/*": ["../../packages/shared/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "env.d.ts"]
}
