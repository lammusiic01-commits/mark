{
  "name": "@mark/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.mjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@mark/shared": "*",
    "cheerio": "1.2.0",
    "express": "4.22.3",
    "node-cron": "3.0.3",
    "qrcode": "^1.5.4",
    "sql.js": "1.14.2",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "basic-ftp": "5.3.1",
    "playwright-core": "1.64.0",
    "ssh2-sftp-client": "11.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "supertest": "7.3.1",
    "vitest": "3.2.7"
  }
}
