# ══════════════════════════════════════════════════════════════
#  AI МАРКЕТОЛОГ — СЕКРЕТНЫЕ КЛЮЧИ
#
#  start.bat сам скопирует этот файл в secrets.env при первом запуске.
#  НЕ коммить secrets.env в git!
#  WEBAPP_URL сюда НЕ пишется: HTTPS-адрес генерируется Cloudflare Tunnel
#  при каждом запуске и сохраняется в tunnel.url.
# ══════════════════════════════════════════════════════════════


# ─── TELEGRAM BOT (ОБЯЗАТЕЛЬНО) ──────────────────────────────
# @BotFather → /newbot → скопируй токен
BOT_TOKEN=

# Telegram ID администраторов через запятую (подтверждение пополнений).
# Свой ID можно узнать у @userinfobot
ADMIN_TG_IDS=


# ─── ПРОКСИ TELEGRAM API (ОБЯЗАТЕЛЬНО ДЛЯ РФ) ────────────────
# Cloudflare Worker, который форвардит запросы к api.telegram.org
# Без этого бот НЕ РАБОТАЕТ в России (api.telegram.org заблокирован).
# Формат: https://имя-воркера.имя-пользователя.workers.dev
TELEGRAM_PROXY_URL=https://tg-proxy.lammusiic01.workers.dev


# ─── OPENROUTER AI (бесплатно, необязательно) ────────────────
# https://openrouter.ai/keys
# Без ключа приложение работает полностью: AI лишь комментирует скриптовые расчёты.
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.0-flash-exp:free
# Списание за один AI-совет при использовании общего ключа, копейки (300 = 3 ₽)
AI_CHARGE_KOP=300


# ─── ШИФРОВАНИЕ (авто-генерация, не трогай) ──────────────────
ENCRYPTION_KEY=


# ─── ОПЛАТА: пополнение баланса по QR (ST00012, СБП/банк) ────
# SBP_MERCHANT_ID — ФИО или название получателя, как в банковских реквизитах
# SBP_ACCOUNT     — расчётный счёт получателя (20 цифр)
# SBP_BIC         — БИК банка получателя (необязательно)
SBP_MERCHANT_ID=
SBP_ACCOUNT=
SBP_BIC=
MIN_TOPUP_RUB=100


# ─── СЕРВЕР ──────────────────────────────────────────────────
# Локальный порт FastAPI. Cloudflare Tunnel смотрит именно на него.
PORT=8000

# Интервал проверки доступности сайтов пользователей, секунды
MONITOR_INTERVAL_SEC=900

# Только для разработки в браузере без Telegram. В продакшене оставь 0!
DEV_MODE=0
