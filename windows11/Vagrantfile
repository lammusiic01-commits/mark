# -*- mode: ruby -*-
# vi: set ft=ruby :
# ==============================================================================
# Готовый профиль легковесной Linux VM для Windows 11 (VirtualBox / Hyper-V)
# Разворачивает изолированный шлюз с IP 192.168.0.2 в режиме Сетевого моста
# (Bridged Adapter) на кабельном подключении к роутеру Tenda TX2 (192.168.0.1).
# Запуск: cd windows11 && vagrant up
# ==============================================================================

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.hostname = "tenda-smart-gateway"

  # Режим сетевого моста (Bridged Adapter) с фиксированным IP 192.168.0.2 в сети Tenda TX2
  config.vm.network "public_network",
    ip: "192.168.0.2",
    netmask: "255.255.255.0",
    gateway: "192.168.0.1"

  # Монтируем папку проекта внутрь виртуальной машины
  config.vm.synced_folder "..", "/opt/tenda-gateway"

  # Потребляет всего 384 МБ ОЗУ и 1 ядро CPU в фоновом режиме Windows 11
  config.vm.provider "virtualbox" do |vb|
    vb.name = "Tenda-TX2-Smart-Gateway"
    vb.memory = "384"
    vb.cpus = 1
    vb.gui = false
    vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
  end

  config.vm.provider "hyperv" do |hv|
    hv.vmname = "Tenda-TX2-Smart-Gateway"
    hv.memory = 512
    hv.cpus = 1
  end

  # Автоматическая установка Sing-box, Dnsmasq, Nftables и Веб-панели при старте
  config.vm.provision "shell", inline: <<-SHELL
    export DEBIAN_FRONTEND=noninteractive
    ip route replace default via 192.168.0.1
    echo "nameserver 77.88.8.8" > /etc/resolv.conf
    bash /opt/tenda-gateway/scripts/setup-gateway.sh
  SHELL
end
