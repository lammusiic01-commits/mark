# ═══════════════════════════════════════════════════════════════
#    AI МАРКЕТОЛОГ — ФАЙЛ СЕКРЕТОВ
# ═══════════════════════════════════════════════════════════════
# Скопируй этот файл в secrets.env и заполни своими значениями.
# НЕ коммить secrets.env в git — он уже в .gitignore
#
# Быстрый путь: просто запусти start.bat (Windows) или ./start.sh —
# скрипт сам создаст secrets.env, откроет его и сгенерирует ENCRYPTION_KEY.
# ═══════════════════════════════════════════════════════════════


# ─── TELEGRAM ──────────────────────────────────────────────────
# Токен бота. Получи у @BotFather: /newbot
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# URL твоего WebApp. На локалке — ngrok, на проде — твой домен.
# ОБЯЗАТЕЛЬНО HTTPS.
WEBAPP_URL=https://your-domain.ngrok.io


# ─── ПРОКСИ ДЛЯ TELEGRAM (для работы из РФ) ────────────────────
# Cloudflare Worker, который форвардит запросы к api.telegram.org
TELEGRAM_PROXY_URL=https://tg-proxy.lammusiic01.workers.dev


# ─── OPENROUTER AI (бесплатно) ─────────────────────────────────
# Получи ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Основная модель (используется первой, остальные — fallback)
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free


# ─── БАЗА ДАННЫХ ────────────────────────────────────────────────
# Для локального docker-compose менять не нужно
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_marketer
DB_USER=marketer
DB_PASSWORD=change_me_in_production


# ─── REDIS ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379


# ─── ШИФРОВАНИЕ ─────────────────────────────────────────────────
# Ключ для шифрования API-токенов пользователей в БД.
# Сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Если потеряешь — все пользователи потеряют доступ к своим сервисам
# start.bat / start.sh генерируют ключ автоматически, если строка пустая.
ENCRYPTION_KEY=


# ─── СБП (опционально, для платежей) ────────────────────────────
# Выдаётся банком (Тинькофф Касса / ЮKassa и т.д.)
SBP_MERCHANT_ID=
SBP_ACCOUNT=
SBP_SECRET_KEY=


# ─── ПОРТЫ (менять не обязательно) ──────────────────────────────
API_PORT=8000
WEBAPP_PORT=3000


# ─── РЕЖИМ РАБОТЫ (можно не менять) ─────────────────────────────
# production — строгие проверки и JSON-логи
# development — подробные логи и послабления для локальной отладки
ENV=production
LOG_LEVEL=INFO
